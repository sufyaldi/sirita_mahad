<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bed_tree" model="ir.ui.view">
        <field name="model">hostel.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_id"/>
                <field name="occupancy_status"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_bed_form" model="ir.ui.view">
        <field name="name">hostel.bed.form</field>
        <field name="model">hostel.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="room_id"/>
                    </group>
                    <group>
                        <field name="occupancy_status" readonly="1"/>
                        <field name="is_active"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

