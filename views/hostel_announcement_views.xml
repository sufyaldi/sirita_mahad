<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Announcement Category -->
    <record id="view_announcement_category_tree" model="ir.ui.view">
        <field name="name">hostel.announcement.category.tree</field>
        <field name="model">hostel.announcement.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Announcement Tree -->
    <record id="view_announcement_tree" model="ir.ui.view">
        <field name="name">hostel.announcement.tree</field>
        <field name="model">hostel.announcement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'archived')" decoration-success="is_active">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="priority" widget="priority"/>
                <field name="target_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="is_active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Announcement Form -->
    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">hostel.announcement.form</field>
        <field name="model">hostel.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state not in ('published', 'expired')"/>
                    <button name="action_expire" string="Mark Expired" type="object"
                            invisible="state != 'published'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('published', 'expired', 'archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,expired,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="name" placeholder="Announcement title"/>
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="target_type"/>
                            <field name="building_ids" widget="many2many_tags"
                                   invisible="target_type != 'building'"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" invisible="1"/>
                            <field name="is_active" invisible="1"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="published_date" readonly="1"/>
                            <field name="published_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" widget="html" placeholder="Enter announcement content..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Announcement Search -->
    <record id="view_announcement_search" model="ir.ui.view">
        <field name="name">hostel.announcement.search</field>
        <field name="model">hostel.announcement</field>
        <field name="arch" type="xml">
            <search string="Announcements">
                <field name="name"/>
                <field name="reference"/>
                <field name="category_id"/>
                <field name="content"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'published'])]"/>
                <separator/>
                <filter name="priority_urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="priority_high" string="High" domain="[('priority', '=', 'high')]"/>
                <group>
                    <filter name="group_category" string="Category" domain="[]" context="{'group_by': 'category_id'}"/>
                    <filter name="group_priority" string="Priority" domain="[]" context="{'group_by': 'priority'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: All Announcements -->
    <record id="action_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">hostel.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new announcement for the notice board.</p>
            <p>Use categories and priority to organize. Set start and expiry dates to control visibility.</p>
        </field>
    </record>

    <!-- Action: Notice Board (active announcements only - display view) -->
    <record id="action_notice_board" model="ir.actions.act_window">
        <field name="name">Notice Board</field>
        <field name="res_model">hostel.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active announcements.</p>
            <p>Published announcements with valid start/expiry dates appear here.</p>
        </field>
    </record>

    <!-- Action: Announcement Categories -->
    <record id="action_announcement_category" model="ir.actions.act_window">
        <field name="name">Announcement Categories</field>
        <field name="res_model">hostel.announcement.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
