<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Asset Views -->
    <record id="view_asset_tree" model="ir.ui.view">
        <field name="model">hostel.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_code"/>
                <field name="asset_category_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="room_id"/>
                <field name="state"/>
                <field name="condition"/>
            </list>
        </field>
    </record>

    <record id="view_asset_form" model="ir.ui.view">
        <field name="model">hostel.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="asset_code"/>
                        <field name="asset_category_id"/>
                    </group>
                    <group>
                        <field name="building_id"/>
                        <field name="unit_id"/>
                        <field name="room_id"/>
                        <field name="bed_id"/>
                    </group>
                    <group>
                        <field name="purchase_date"/>
                        <field name="purchase_cost"/>
                        <field name="current_value" readonly="1"/>
                        <field name="warranty_expiry"/>
                    </group>
                    <group>
                        <field name="condition"/>
                        <field name="supplier_id"/>
                        <field name="depreciation_rate"/>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                            <field name="notes"/>
                        </page>
                        <page string="Maintenance History" name="maintenance">
                            <field name="maintenance_history_ids">
                                <list>
                                    <field name="maintenance_date"/>
                                    <field name="maintenance_type"/>
                                    <field name="description"/>
                                    <field name="cost"/>
                                    <field name="vendor_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Service History" name="service">
                            <field name="service_history_ids">
                                <list>
                                    <field name="service_date"/>
                                    <field name="service_type"/>
                                    <field name="description"/>
                                    <field name="cost"/>
                                    <field name="service_provider_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_search" model="ir.ui.view">
        <field name="model">hostel.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_code"/>
                <field name="building_id"/>
                <field name="state"/>
                <group>
                    <filter name="building" string="Building" domain="[]" context="{'group_by': 'building_id'}"/>
                    <filter name="category" string="Category" domain="[]" context="{'group_by': 'asset_category_id'}"/>
                    <filter name="state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">hostel.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Asset Category Views -->
    <record id="view_asset_category_tree" model="ir.ui.view">
        <field name="model">hostel.asset.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">hostel.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
