<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

<t t-name="sirita_mahad.HostelDashboard">
    <div class="o_hostel_dashboard">
        <div class="oe_dashboard o_hostel_dashboard_container">
            <!-- Header -->
            <div class="o_hostel_dashboard_header">
                <div class="o_hostel_dashboard_header_top">
                    <div class="o_hostel_dashboard_header_brand">
                        <div class="o_hostel_dashboard_logo">
                            <i class="fa fa-home" title="Hostel"/>
                        </div>
                        <div class="o_hostel_dashboard_header_title_wrap">
                            <h1 class="o_hostel_dashboard_title">Manajemen Ma'had Al-Jami'ah</h1>
                            <span class="o_hostel_dashboard_subtitle">Monitoring Akademik &amp; Layanan Santri</span>
                        </div>
                    </div>
                </div>
                <div class="o_hostel_dashboard_header_bottom">
                    <div class="o_hostel_date_filter_card">
                        <div class="o_hostel_date_filter_group">
                            <span class="o_hostel_date_filter_label o_form_label">From</span>
                            <input type="date" class="o_hostel_date_input"
                                   t-att-value="this.state.date_from"
                                   t-on-change="this.onDateFromChange"/>
                        </div>
                        <span class="o_hostel_date_filter_sep">→</span>
                        <div class="o_hostel_date_filter_group">
                            <span class="o_hostel_date_filter_label o_form_label">To</span>
                            <input type="date" class="o_hostel_date_input"
                                   t-att-value="this.state.date_to"
                                   t-on-change="this.onDateToChange"/>
                        </div>
                        <div class="o_hostel_date_filter_btns">
                            <a href="#" role="button" class="o_hostel_header_btn o_hostel_header_btn_apply" t-on-click.prevent="this.onApplyDateRange"><i class="fa fa-filter" title="Apply filter"/> Apply</a>
                            <a href="#" role="button" class="o_hostel_header_btn o_hostel_header_btn_reset" t-on-click.prevent="this.onResetDateRange">Reset</a>
                        </div>
                    </div>
                    <t t-if="this.state.statistics.date_from and this.state.statistics.date_to">
                        <span class="o_hostel_dashboard_range_label">
                            <i class="fa fa-calendar-o" title="Date range"/>
                            <t t-out="this.state.statistics.date_from"/> — <t t-out="this.state.statistics.date_to"/>
                        </span>
                    </t>
                </div>
            </div>

            <t t-if="this.state.loading">
                <div class="o_hostel_loading">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary" title="Loading"/>
                    <p class="mt-3">Loading dashboard...</p>
                </div>
            </t>

            <t t-if="!this.state.loading">
                <div class="o_hostel_dashboard_new">
                    <!-- Top Row: Occupancy &amp; Contracts | Revenue &amp; Performance -->
                    <div class="o_hostel_top_row">
                        <!-- Left: Okupansi Hunian & Mahasantri -->
                        <div class="o_hostel_block o_hostel_block_primary">
                            <h6 class="o_hostel_block_title">Okupansi Hunian &amp; Mahasantri</h6>
                            <div class="o_hostel_occ_cards">
                                <div class="o_hostel_occ_card o_hostel_occ_pct hostel-clickable" t-on-click="this.onActiveStudents">
                                    <div class="o_hostel_occ_card_icon"><i class="fa fa-pie-chart" title="Occupancy"/></div>
                                    <div class="o_hostel_occ_card_body">
                                        <span class="o_hostel_occ_card_value"><t t-out="this.state.statistics.occupancy_rate"/>%</span>
                                        <span class="o_hostel_occ_card_label">Tingkat Hunian</span>
                                    </div>
                                </div>
                                <div class="o_hostel_occ_card o_hostel_occ_students hostel-clickable" t-on-click="this.onActiveStudents">
                                    <div class="o_hostel_occ_card_icon"><i class="fa fa-users" title="Mahasantri Aktif"/></div>
                                    <div class="o_hostel_occ_card_body">
                                        <span class="o_hostel_occ_card_value"><t t-out="this.state.statistics.active_students_count"/></span>
                                        <span class="o_hostel_occ_card_label">Mahasantri Aktif</span>
                                    </div>
                                </div>
                                <div class="o_hostel_occ_card o_hostel_occ_vacant hostel-clickable" t-on-click="this.onVacantSpaces">
                                    <div class="o_hostel_occ_card_icon"><i class="fa fa-bed" title="Ranjang Kosong"/></div>
                                    <div class="o_hostel_occ_card_body">
                                        <span class="o_hostel_occ_card_value"><t t-out="this.state.statistics.vacant_spaces_count"/></span>
                                        <span class="o_hostel_occ_card_label">Ranjang Kosong</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_hostel_occ_metrics">
                                <div class="o_hostel_occ_metric" t-on-click="this.onDailyCheckin">
                                    <i class="fa fa-sign-in" title="Kedatangan"/>
                                    <span class="o_hostel_occ_metric_val"><t t-out="this.state.statistics.daily_checkin_count"/></span>
                                    <span class="o_hostel_occ_metric_lbl">Kedatangan Hari Ini</span>
                                </div>
                                <div class="o_hostel_occ_metric" t-on-click="this.onDailyContractEnding">
                                    <i class="fa fa-calendar-times-o" title="Selesai Hari Ini"/>
                                    <span class="o_hostel_occ_metric_val"><t t-out="this.state.statistics.daily_contract_ending_count"/></span>
                                    <span class="o_hostel_occ_metric_lbl">Selesai Hari Ini</span>
                                </div>
                                <div class="o_hostel_occ_metric o_hostel_occ_metric_warn" t-on-click="this.onUpcoming10Days">
                                    <i class="fa fa-exclamation-triangle" title="Masa Tinggal Selesai &lt; 10 Hari"/>
                                    <span class="o_hostel_occ_metric_val"><t t-out="this.state.statistics.upcoming_10_days_count"/></span>
                                    <span class="o_hostel_occ_metric_lbl">Habis &lt; 10 Hari</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Revenue &amp; Performance -->
                        <div class="o_hostel_block o_hostel_block_secondary">
                            <h6 class="o_hostel_block_title">Revenue &amp; Performance</h6>
                            <div class="o_hostel_rev_cards">
                                <div class="o_hostel_rev_card o_hostel_rev_paid hostel-clickable" role="button" t-on-click="this.onRentInvoices">
                                    <div class="o_hostel_rev_card_icon"><i class="fa fa-check-circle" title="Paid"/></div>
                                    <div class="o_hostel_rev_card_body">
                                        <span class="o_hostel_rev_card_value"><t t-out="this.state.statistics.revenue_paid"/></span>
                                        <span class="o_hostel_rev_card_label">Revenue Paid</span>
                                    </div>
                                </div>
                                <div class="o_hostel_rev_card o_hostel_rev_out hostel-clickable" t-on-click="this.onRentInvoices">
                                    <div class="o_hostel_rev_card_icon"><i class="fa fa-clock-o" title="Outstanding"/></div>
                                    <div class="o_hostel_rev_card_body">
                                        <span class="o_hostel_rev_card_value"><t t-out="this.state.statistics.revenue_outstanding"/></span>
                                        <span class="o_hostel_rev_card_label">Outstanding</span>
                                    </div>
                                </div>
                                <div class="o_hostel_rev_card o_hostel_rev_rate">
                                    <div class="o_hostel_rev_card_icon"><i class="fa fa-percent" title="Collection Rate"/></div>
                                    <div class="o_hostel_rev_card_body">
                                        <span class="o_hostel_rev_card_value"><t t-out="this.state.statistics.collection_rate or 0"/>%</span>
                                        <span class="o_hostel_rev_card_label">Collection Rate</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_hostel_rev_metrics">
                                <div class="o_hostel_rev_metric" t-on-click="this.onVisitorsToday">
                                    <i class="fa fa-user-plus" title="Visitors in range"/>
                                    <span class="o_hostel_rev_metric_val"><t t-out="this.state.statistics.visitor_in_range_count"/></span>
                                    <span class="o_hostel_rev_metric_lbl">Visitors</span>
                                </div>
                                <div class="o_hostel_rev_metric" t-on-click="this.onStudentAttendance">
                                    <i class="fa fa-calendar-check-o" title="Attendance in range"/>
                                    <span class="o_hostel_rev_metric_val"><t t-out="this.state.statistics.attendance_in_range_count"/></span>
                                    <span class="o_hostel_rev_metric_lbl">Attendance</span>
                                </div>
                                <div class="o_hostel_rev_metric">
                                    <i class="fa fa-bed" title="Total beds"/>
                                    <span class="o_hostel_rev_metric_val"><t t-out="this.state.statistics.total_beds"/></span>
                                    <span class="o_hostel_rev_metric_lbl">Total Beds</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Row: Visitors &amp; Operations | Maintenance &amp; Services -->
                    <div class="o_hostel_bottom_row">
                        <!-- Left: Visitors &amp; Operations -->
                        <div class="o_hostel_block o_hostel_block_visitors">
                            <div class="o_hostel_section_head">
                                <h6 class="o_hostel_block_title"><i class="fa fa-user-plus" title="Visitors"/> Visitors &amp; Operations</h6>
                                <a href="#" role="button" class="o_hostel_section_action" t-on-click.prevent="this.onVisitors">View All <i class="fa fa-angle-right" title="Go"/></a>
                            </div>
                            <div class="o_hostel_stat_cards">
                                <div class="o_hostel_stat_card o_hostel_stat_blue" t-on-click="this.onVisitorsToday">
                                    <div class="o_hostel_stat_icon"><i class="fa fa-user-plus" title="Visitors Today"/></div>
                                    <div class="o_hostel_stat_body">
                                        <span class="o_hostel_stat_value"><t t-out="this.state.statistics.visitor_today_count"/></span>
                                        <span class="o_hostel_stat_label">Visitors Today</span>
                                    </div>
                                </div>
                                <div class="o_hostel_stat_card o_hostel_stat_amber" t-on-click="this.onPendingVisitors">
                                    <div class="o_hostel_stat_icon"><i class="fa fa-clock-o" title="Pending"/></div>
                                    <div class="o_hostel_stat_body">
                                        <span class="o_hostel_stat_value"><t t-out="this.state.statistics.visitor_pending_count"/></span>
                                        <span class="o_hostel_stat_label">Pending</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_hostel_stat_footer">
                                <div class="o_hostel_stat_pill">
                                    <i class="fa fa-calendar" title="Today"/>
                                    <strong><t t-out="this.state.statistics.visitor_today_count"/></strong>
                                    <span>Today</span>
                                </div>
                                <div class="o_hostel_stat_pill">
                                    <i class="fa fa-hourglass-half" title="Pending"/>
                                    <strong><t t-out="this.state.statistics.visitor_pending_count"/></strong>
                                    <span>Pending</span>
                                </div>
                                <div class="o_hostel_stat_pill">
                                    <i class="fa fa-calendar-check-o" title="In Range"/>
                                    <strong><t t-out="this.state.statistics.visitor_in_range_count"/></strong>
                                    <span>In Range</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Maintenance &amp; Services -->
                        <div class="o_hostel_block o_hostel_block_maint">
                            <div class="o_hostel_section_head">
                                <h6 class="o_hostel_block_title"><i class="fa fa-wrench" title="Maintenance"/> Maintenance &amp; Services</h6>
                                <a href="#" role="button" class="o_hostel_section_action" t-on-click.prevent="this.onMaintenanceOpen">View All <i class="fa fa-angle-right" title="Go"/></a>
                            </div>
                            <div class="o_hostel_stat_cards o_hostel_stat_cards_3">
                                <div class="o_hostel_stat_card o_hostel_stat_red" t-on-click="this.onMaintenanceOpen">
                                    <div class="o_hostel_stat_icon"><i class="fa fa-wrench" title="Maintenance Open"/></div>
                                    <div class="o_hostel_stat_body">
                                        <span class="o_hostel_stat_value"><t t-out="this.state.statistics.maintenance_open_count"/></span>
                                        <span class="o_hostel_stat_label">Maintenance</span>
                                    </div>
                                </div>
                                <div class="o_hostel_stat_card o_hostel_stat_purple" t-on-click="this.onComplaintsOpen">
                                    <div class="o_hostel_stat_icon"><i class="fa fa-exclamation-circle" title="Complaints"/></div>
                                    <div class="o_hostel_stat_body">
                                        <span class="o_hostel_stat_value"><t t-out="this.state.statistics.complaints_open_count"/></span>
                                        <span class="o_hostel_stat_label">Complaints</span>
                                    </div>
                                </div>
                                <div class="o_hostel_stat_card o_hostel_stat_teal" t-on-click="this.onLaundryOpen">
                                    <div class="o_hostel_stat_icon"><i class="fa fa-shopping-basket" title="Laundry"/></div>
                                    <div class="o_hostel_stat_body">
                                        <span class="o_hostel_stat_value"><t t-out="this.state.statistics.laundry_open_count"/></span>
                                        <span class="o_hostel_stat_label">Laundry</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_hostel_stat_footer">
                                <t t-foreach="this.state.chartData.maintenance_by_state" t-as="item" t-key="item_index">
                                    <div class="o_hostel_stat_pill">
                                        <i t-attf-class="fa {{ item.label === 'Open' ? 'fa-folder-open' : item.label === 'In Progress' ? 'fa-spinner' : 'fa-check-circle' }}" t-att-title="item.label"/>
                                        <strong><t t-out="item.value"/></strong>
                                        <span><t t-out="item.label"/></span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Panel -->
                    <div class="o_hostel_charts_panel">
                        <div class="o_hostel_charts_panel_header">
                            <div class="o_hostel_charts_panel_title">
                                <i class="fa fa-bar-chart" title="Analytics"/>
                                <span>Analytics &amp; Reports</span>
                            </div>
                            <div class="o_hostel_charts_panel_subtitle">Building occupancy, revenue, and activity trends</div>
                        </div>
                        <div class="o_hostel_charts_panel_body">
                            <div class="o_hostel_charts_grid">
                                <div class="o_hostel_chart_panel o_hostel_chart_panel_lg">
                                    <div class="o_hostel_chart_panel_inner">
                                        <div class="o_hostel_chart_panel_header">
                                            <i class="fa fa-building" title="Buildings"/>
                                            <span>Occupancy by Building</span>
                                        </div>
                                        <div class="o_hostel_chart_panel_content">
                                            <t t-if="this.state.chartData.occupancy_by_building.length === 0">
                                                <p class="text-muted mb-0 small text-center">No building data</p>
                                            </t>
                                            <t t-else="">
                                                <div class="o_hostel_occupancy_chart">
                                                    <t t-foreach="this.state.chartData.occupancy_by_building" t-as="item" t-key="item_index">
                                                        <div t-attf-class="o_hostel_occupancy_card {{ item.percentage >= 80 ? 'o_hostel_occ_high' : item.percentage >= 50 ? 'o_hostel_occ_med' : 'o_hostel_occ_low' }}">
                                                            <div class="o_hostel_occupancy_circle" t-att-style="'--pct: ' + item.percentage">
                                                                <span class="o_hostel_occupancy_pct"><t t-out="item.percentage"/>%</span>
                                                            </div>
                                                            <div class="o_hostel_occupancy_label"><t t-out="item.name"/></div>
                                                            <div class="o_hostel_occupancy_stats"><t t-out="item.value"/>/<t t-out="item.total"/> beds</div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_hostel_chart_panel o_hostel_chart_panel_lg">
                                    <div class="o_hostel_chart_panel_inner">
                                        <div class="o_hostel_chart_panel_header">
                                            <i class="fa fa-pie-chart" title="Revenue"/>
                                            <span>Revenue (Last 6 Months)</span>
                                        </div>
                                        <div class="o_hostel_chart_panel_content">
                                            <div class="o_hostel_chartjs_wrap">
                                                <canvas t-ref="this.revenueChartRef"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_hostel_chart_panel o_hostel_chart_panel_sm">
                                    <div class="o_hostel_chart_panel_inner">
                                        <div class="o_hostel_chart_panel_header">
                                            <i class="fa fa-calendar-check-o" title="Attendance"/>
                                            <span>Attendance (7d)</span>
                                        </div>
                                        <div class="o_hostel_chart_panel_content">
                                            <div class="o_hostel_chartjs_wrap o_hostel_chartjs_compact">
                                                <canvas t-ref="this.attendanceChartRef"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_hostel_chart_panel o_hostel_chart_panel_sm">
                                    <div class="o_hostel_chart_panel_inner">
                                        <div class="o_hostel_chart_panel_header">
                                            <i class="fa fa-users" title="Visitors"/>
                                            <span>Visitors (7d)</span>
                                        </div>
                                        <div class="o_hostel_chart_panel_content">
                                            <div class="o_hostel_chartjs_wrap o_hostel_chartjs_compact">
                                                <canvas t-ref="this.visitorsChartRef"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="o_hostel_qa_panel">
                        <div class="o_hostel_qa_head">
                            <h6 class="o_hostel_qa_title"><i class="fa fa-bolt" title="Quick actions"/> Quick Actions</h6>
                        </div>
                        <div class="o_hostel_qa_grid">
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onViewContracts">
                                <div class="o_hostel_qa_icon o_hostel_qa_blue"><i class="fa fa-file-text-o" title="Contracts"/></div>
                                <span class="o_hostel_qa_label">Contracts</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onCheckInOut">
                                <div class="o_hostel_qa_icon o_hostel_qa_green"><i class="fa fa-sign-in" title="Check-in"/></div>
                                <span class="o_hostel_qa_label">Check-In/Out</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onManageRooms">
                                <div class="o_hostel_qa_icon o_hostel_qa_purple"><i class="fa fa-bed" title="Rooms"/></div>
                                <span class="o_hostel_qa_label">Rooms</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onVisitors">
                                <div class="o_hostel_qa_icon o_hostel_qa_teal"><i class="fa fa-user-plus" title="Visitors"/></div>
                                <span class="o_hostel_qa_label">Visitors</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onStudentAttendance">
                                <div class="o_hostel_qa_icon o_hostel_qa_indigo"><i class="fa fa-check-circle" title="Attendance"/></div>
                                <span class="o_hostel_qa_label">Attendance</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onRentInvoices">
                                <div class="o_hostel_qa_icon o_hostel_qa_amber"><i class="fa fa-money" title="Invoices"/></div>
                                <span class="o_hostel_qa_label">Rent Invoices</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onComplaints">
                                <div class="o_hostel_qa_icon o_hostel_qa_red"><i class="fa fa-exclamation-circle" title="Complaints"/></div>
                                <span class="o_hostel_qa_label">Complaints</span>
                            </a>
                            <a href="#" role="button" class="o_hostel_qa_card" t-on-click.prevent="this.onAnnouncementsMenu">
                                <div class="o_hostel_qa_icon o_hostel_qa_cyan"><i class="fa fa-bullhorn" title="Notice Board"/></div>
                                <span class="o_hostel_qa_label">Notice Board</span>
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

</templates>
