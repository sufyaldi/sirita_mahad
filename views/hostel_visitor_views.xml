<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Tree View -->
    <record id="view_visitor_tree" model="ir.ui.view">
        <field name="name">hostel.visitor.tree</field>
        <field name="model">hostel.visitor</field>
        <field name="arch" type="xml">
            <list decoration-info="status == 'pending'" decoration-success="status == 'approved'" decoration-warning="status == 'checked_in'" decoration-muted="status == 'completed' or status == 'cancelled'" decoration-danger="status == 'rejected' or is_overdue == True">
                <field name="name"/>
                <field name="visitor_id_number"/>
                <field name="phone"/>
                <field name="student_id"/>
                <field name="building_id"/>
                <field name="visit_datetime"/>
                <field name="checkin_datetime"/>
                <field name="checkout_datetime"/>
                <field name="status" widget="badge" decoration-success="status == 'approved' or status == 'completed'" decoration-info="status == 'pending' or status == 'checked_in'" decoration-danger="status == 'rejected' or status == 'cancelled'"/>
                <field name="approved_by_id"/>
                <field name="is_overdue" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_visitor_form" model="ir.ui.view">
        <field name="name">hostel.visitor.form</field>
        <field name="model">hostel.visitor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" invisible="status != 'pending'" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status != 'pending'" class="btn-danger"/>
                    <button name="action_checkin" type="object" string="Check In" invisible="status not in ['approved', 'checked_in']" class="oe_highlight"/>
                    <button name="action_checkout" type="object" string="Check Out" invisible="status != 'checked_in'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ['completed', 'cancelled']"/>
                    <button name="action_reset_to_pending" type="object" string="Reset to Pending" invisible="status in ['pending', 'checked_in']"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,approved,checked_in,completed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        </div>

                    <group>
                        <group>
                            <field name="name" placeholder="Visitor Name"/>
                            <field name="visitor_id_number" placeholder="ID Number"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="student_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="building_id" readonly="1"/>
                            <field name="visit_datetime"/>
                            <field name="expected_duration"/>
                        </group>
                    </group>

                    <group>
                        <field name="purpose" placeholder="Purpose of visit..."/>
                    </group>

                    <notebook>
                        <page string="Approval Details" invisible="status == 'pending'">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approval_datetime" readonly="1"/>
                                </group>
                                <group>
                                    <field name="rejection_reason" readonly="1" invisible="status != 'rejected'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Check-In/Check-Out">
                            <group>
                                <group>
                                    <field name="checkin_datetime" readonly="1"/>
                                    <field name="checkout_datetime" readonly="1"/>
                                </group>
                                <group>
                                    <field name="actual_duration" readonly="1"/>
                                    <field name="is_overdue" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Documents">
                            <group>
                                <group>
                                    <field name="visitor_photo" widget="image" class="oe_avatar"/>
                                </group>
                                <group>
                                    <field name="visitor_id_document" filename="visitor_id_document_filename"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes or remarks..."/>
                        </page>

                        <page string="Activities" name="activities">
                            <field name="activity_ids" nolabel="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="activity_type_id"/>
                                    <field name="user_id"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_visitor_search" model="ir.ui.view">
        <field name="name">hostel.visitor.search</field>
        <field name="model">hostel.visitor</field>
        <field name="arch" type="xml">
            <search string="Visitors">
                <field name="name" string="Visitor Name"/>
                <field name="visitor_id_number" string="ID Number"/>
                <field name="phone"/>
                <field name="student_id" string="Student"/>
                <field name="building_id" string="Building"/>
                <field name="approved_by_id" string="Approved By"/>

                <filter string="Pending Approval" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Checked In" name="checked_in" domain="[('status', '=', 'checked_in')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>

                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>

                <group>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Student" name="group_student" domain="[]" context="{'group_by': 'student_id'}"/>
                    <filter string="Building" name="group_building" domain="[]" context="{'group_by': 'building_id'}"/>
                    <filter string="Approved By" name="group_approved_by" domain="[]" context="{'group_by': 'approved_by_id'}"/>
                    <filter string="Visit Date" name="group_visit_date" domain="[]" context="{'group_by': 'visit_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_visitor_calendar" model="ir.ui.view">
        <field name="name">hostel.visitor.calendar</field>
        <field name="model">hostel.visitor</field>
        <field name="arch" type="xml">
            <calendar string="Visitors" date_start="visit_datetime" color="status" quick_create="0">
                <field name="name"/>
                <field name="student_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_visitor_kanban" model="ir.ui.view">
        <field name="name">hostel.visitor.kanban</field>
        <field name="model">hostel.visitor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="student_id"/>
                <field name="visit_datetime"/>
                <field name="status"/>
                <field name="building_id"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="student_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-building" title="Building"/> <field name="building_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar" title="Visit Date"/> <field name="visit_datetime"/>
                                    </div>
                                    <div t-if="record.is_overdue.raw_value" class="text-danger">
                                        <i class="fa fa-exclamation-triangle" title="Overdue"/> Overdue
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_visitor" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="res_model">hostel.visitor</field>
        <field name="view_mode">list,form,calendar,kanban</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new visitor record
            </p>
            <p>
                Track and manage all visitors to the hostel. Visitors must be approved before they can check in.
            </p>
        </field>
    </record>

    <!-- Reject Wizard Form -->
    <record id="view_visitor_reject_wizard_form" model="ir.ui.view">
        <field name="name">hostel.visitor.reject.wizard.form</field>
        <field name="model">hostel.visitor.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="visitor_id" readonly="1"/>
                </group>
                <group>
                    <field name="rejection_reason" placeholder="Enter reason for rejection..." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Reject Wizard Action -->
    <record id="action_visitor_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Visit Request</field>
        <field name="res_model">hostel.visitor.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>