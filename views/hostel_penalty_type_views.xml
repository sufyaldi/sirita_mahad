<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Penalty Type Views -->
    <record id="view_penalty_type_tree" model="ir.ui.view">
        <field name="model">hostel.penalty.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="penalty_category"/>
                <field name="default_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_penalty_type_form" model="ir.ui.view">
        <field name="model">hostel.penalty.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="penalty_category"/>
                        <field name="default_amount"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_penalty_type" model="ir.actions.act_window">
        <field name="name">Penalty Types</field>
        <field name="res_model">hostel.penalty.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_penalty_type"
              name="Penalty Types"
              parent="menu_hostel_master"
              action="action_penalty_type"
              sequence="100"
              groups="sirita_mahad.group_hostel_admin"/>

</odoo>
