<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_room_tree" model="ir.ui.view">
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="room_type"/>
                <field name="gender"/>
                <field name="room_status"/>
            </list>
        </field>
    </record>

    <record id="view_room_form" model="ir.ui.view">
        <field name="name">hostel.room.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="unit_id"/>
                    </group>
                    <group>
                        <field name="room_type"/>
                        <field name="gender"/>
                        <field name="room_status"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_room_search" model="ir.ui.view">
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="room_type"/>
                <field name="gender"/>
                <field name="room_status"/>
                <field name="unit_id" string="Building" domain="[]"/>
                <filter name="ready" string="Ready for Arrival" domain="[('room_status', '=', 'ready')]"/>
                <filter name="dirty" string="Dirty" domain="[('room_status', '=', 'dirty')]"/>
                <filter name="buffer" string="Buffer Room" domain="[('room_status', '=', 'buffer')]"/>
                <filter name="out_of_order" string="Out of Order" domain="[('room_status', '=', 'out')]"/>
                <group>
<!--                    <filter name="building" string="Building" context="{'group_by': 'unit_id.building_id'}"/>-->
                    <filter name="unit" string="Unit" domain="[]" context="{'group_by': 'unit_id'}"/>
                    <filter name="room_type" string="Room Type" domain="[]" context="{'group_by': 'room_type'}"/>
                    <filter name="gender" string="Gender" domain="[]" context="{'group_by': 'gender'}"/>
                    <filter name="status" string="Status" domain="[]" context="{'group_by': 'room_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_room" model="ir.actions.act_window">
        <field name="res_model">hostel.room</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>