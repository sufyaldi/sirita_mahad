<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_unit_tree" model="ir.ui.view">
        <field name="model">hostel.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building_id"/>
                <field name="floor"/>
                <field name="unit_type"/>
            </list>
        </field>
    </record>

    <record id="view_unit_form" model="ir.ui.view">
        <field name="name">hostel.unit.form</field>
        <field name="model">hostel.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building_id"/>
                    </group>
                    <group>
                        <field name="floor"/>
                        <field name="unit_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_unit_search" model="ir.ui.view">
        <field name="model">hostel.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="building_id"/>
                <group>
                    <filter name="building" string="Building" domain="[]" context="{'group_by': 'building_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_unit" model="ir.actions.act_window">
        <field name="res_model">hostel.unit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>