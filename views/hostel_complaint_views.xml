<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Sequence for complaint reference -->
    <record id="seq_hostel_complaint" model="ir.sequence">
        <field name="name">Hostel Complaint</field>
        <field name="code">hostel.complaint</field>
        <field name="prefix">COMP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Tree View -->
    <record id="view_complaint_tree" model="ir.ui.view">
        <field name="name">hostel.complaint.tree</field>
        <field name="model">hostel.complaint</field>
        <field name="arch" type="xml">
            <list
                  decoration-danger="priority == 'urgent'"
                  decoration-warning="priority == 'high'"
                  decoration-success="state in ('resolved', 'closed')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="subject"/>
                <field name="student_id"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('resolved', 'closed')"
                       decoration-info="state in ('submitted', 'under_review')"
                       decoration-warning="state == 'escalated'"
                       decoration-muted="state == 'cancelled'"
                       decoration-danger="state == 'draft'"/>
                <field name="assigned_to_id"/>
                <field name="resolved_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_complaint_form" model="ir.ui.view">
        <field name="name">hostel.complaint.form</field>
        <field name="model">hostel.complaint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_assign_review"
                            type="object"
                            string="Assign / Under Review"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_resolve"
                            type="object"
                            string="Mark Resolved"
                            class="oe_highlight"
                            invisible="state != 'under_review'"/>
                    <button name="action_close"
                            type="object"
                            string="Close"
                            invisible="state not in ('resolved', 'submitted', 'under_review')"/>
                    <button name="action_escalate"
                            type="object"
                            string="Escalate"
                            invisible="state in ('resolved', 'closed', 'cancelled')"
                            class="btn-warning"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('resolved', 'closed', 'cancelled')"
                            class="btn-danger"/>
                    <button name="action_reset_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="subject" placeholder="Brief subject..."/>
                            <field name="description" placeholder="Describe the complaint in detail..."/>
                            <field name="priority" widget="priority"/>
                            <field name="assigned_to_id"/>
                        </group>
                        <group>
                            <field name="building_id"/>
                            <field name="room_id"/>
                            <field name="resolution_notes" placeholder="Resolution / action taken..."/>
                            <field name="resolved_date" readonly="1"/>
                            <field name="resolved_by_id" readonly="1"/>
                            <field name="escalation_notes" placeholder="Escalation reason and notes..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities" name="activities">
                            <field name="activity_ids" nolabel="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="activity_type_id"/>
                                    <field name="user_id"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_complaint_search" model="ir.ui.view">
        <field name="name">hostel.complaint.search</field>
        <field name="model">hostel.complaint</field>
        <field name="arch" type="xml">
            <search string="Complaints">
                <field name="name"/>
                <field name="subject"/>
                <field name="description"/>
                <field name="student_id"/>
                <field name="building_id"/>
                <field name="assigned_to_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Escalated" name="escalated" domain="[('state', '=', 'escalated')]"/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('state', 'in', ['submitted', 'under_review', 'escalated'])]"/>
                <filter string="My Assignments" name="my_assignments" domain="[('assigned_to_id.user_id', '=', uid)]"/>
                <group>
                    <filter string="Category" name="group_category" domain="[]" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Student" name="group_student" domain="[]" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_complaint" model="ir.actions.act_window">
        <field name="name">Complaints &amp; Grievances</field>
        <field name="res_model">hostel.complaint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a complaint or grievance.
            </p>
            <p>
                Track student complaints by category (noise, cleanliness, facilities, staff behavior, safety, etc.), priority, and status. Assign staff, record resolution, and escalate when needed.
            </p>
        </field>
    </record>
</odoo>
