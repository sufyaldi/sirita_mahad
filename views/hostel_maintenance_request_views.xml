<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Sequence for maintenance request reference -->
    <record id="seq_hostel_maintenance_request" model="ir.sequence">
        <field name="name">Hostel Maintenance Request</field>
        <field name="code">hostel.maintenance.request</field>
        <field name="prefix">MREQ</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Tree View -->
    <record id="view_maintenance_request_tree" model="ir.ui.view">
        <field name="name">hostel.maintenance.request.tree</field>
        <field name="model">hostel.maintenance.request</field>
        <field name="arch" type="xml">
            <list
                  decoration-danger="priority == 'urgent'"
                  decoration-warning="priority == 'high'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="request_type"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state in ['submitted', 'assigned', 'in_progress']"
                       decoration-muted="state == 'cancelled'"
                       decoration-danger="state == 'draft'"/>
                <field name="building_id"/>
                <field name="room_id"/>
                <field name="assigned_to_id"/>
                <field name="cost"/>
                <field name="requested_by_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_maintenance_request_form" model="ir.ui.view">
        <field name="name">hostel.maintenance.request.form</field>
        <field name="model">hostel.maintenance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_assign"
                            type="object"
                            string="Assign"
                            invisible="state not in ('submitted', 'assigned')"/>
                    <button name="action_start"
                            type="object"
                            string="Start"
                            invisible="state not in ('submitted', 'assigned')"/>
                    <button name="action_complete"
                            type="object"
                            string="Mark Completed"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('completed', 'cancelled')"
                            class="btn-danger"/>
                    <button name="action_reset_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="request_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="state" invisible="1"/>
                            <field name="description" placeholder="Describe the issue..."/>
                            <field name="requested_by_id"/>
                            <field name="assigned_to_id"/>
                        </group>
                        <group>
                            <field name="building_id"/>
                            <field name="room_id"/>
                            <field name="bed_id"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="notes" placeholder="Internal notes..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities" name="activities">
                            <field name="activity_ids" nolabel="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="activity_type_id"/>
                                    <field name="user_id"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_maintenance_request_search" model="ir.ui.view">
        <field name="name">hostel.maintenance.request.search</field>
        <field name="model">hostel.maintenance.request</field>
        <field name="arch" type="xml">
            <search string="Maintenance Requests">
                <field name="name"/>
                <field name="description"/>
                <field name="building_id"/>
                <field name="room_id"/>
                <field name="assigned_to_id"/>
                <field name="requested_by_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                <separator/>
                <filter string="My Assignments" name="my_assignments" domain="[('assigned_to_id.user_id', '=', uid)]"/>
                <group>
                    <filter string="Type" name="group_type" domain="[]" context="{'group_by': 'request_type'}"/>
                    <filter string="Building" name="group_building" domain="[]" context="{'group_by': 'building_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">hostel.maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a maintenance request.
            </p>
            <p>
                Track plumbing, electrical, cleaning, and other maintenance issues by type, priority, and location. Assign staff and record cost.
            </p>
        </field>
    </record>
</odoo>
